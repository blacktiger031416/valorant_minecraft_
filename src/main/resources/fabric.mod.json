{
	"schemaVersion": 1,
	"id": "valorantcraft",
	"version": "${version}",
	"name": "ValorantCraft",
	"description": "Valorant-style tactical shooter mechanics for Minecraft: weapons, agent abilities, spike plant/defuse, and round-based competitive matches.",
	"authors": [
		"blacktiger031416"
	],
	"contact": {
		"homepage": "https://github.com/blacktiger031416/valorant_minecraft_"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.valorantcraft.ValorantCraft"
		],
		"client": [
			"com.valorantcraft.client.ValorantCraftClient"
		]
	},
	"mixins": [
		"valorantcraft.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": "*",
		"minecraft": "~1.21.1",
		"java": ">=21"
	}
